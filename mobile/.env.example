# URL de l'API NestJS.
#  - Émulateur Android : http://10.0.2.2:3000/api (valeur par défaut)
#  - Simulateur iOS    : http://localhost:3000/api (valeur par défaut)
#  - Téléphone réel    : http://<IP-de-votre-PC>:3000/api  (même Wi-Fi ; `ipconfig` pour l'IP)
#  - Production        : https://api.votre-domaine.com/api  (HTTPS obligatoire pour les builds de production)
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api

# Client OAuth « Web » Google (optionnel, réservé : le bouton Google n'est pas encore branché dans l'app).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Suivi des crashs (Sentry, optionnel) : sentry.io > projet React Native > Client Keys (DSN).
# Vide = suivi désactivé.
EXPO_PUBLIC_SENTRY_DSN=
