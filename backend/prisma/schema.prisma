generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe, utilisée par les migrations (le pooler en mode transaction ne les supporte pas).
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum RevenuCategory {
  principal
  secondaire
}

enum DepenseCategory {
  fixe
  variable
}

enum NotificationType {
  info
  warning
  success
  promo
}

enum SupportStatus {
  new
  read
  resolved
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  googleId      String?  @unique @map("google_id")
  fullName      String   @default("") @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  currency      String   @default("EUR")
  locale        String   @default("fr-FR")
  role          Role     @default(user)
  // Visite guidée (product tour) déjà vue : source de vérité, le mobile n'en garde qu'un cache local.
  hasSeenTour   Boolean  @default(false) @map("has_seen_tour")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  refreshTokens  RefreshToken[]
  resetCodes     PasswordResetCode[]
  envelopes      Envelope[]
  revenus        Revenu[]
  depenses       Depense[]
  objectifs      Objectif[]
  notifications  Notification[]
  pushTokens     PushToken[]
  supportMessages SupportMessage[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}

// Les 4 tables synchronisées partagent le même modèle :
//  - id généré côté client (UUID) pour permettre la création hors ligne
//  - updatedAt : horloge client, sert à la résolution de conflits (last-write-wins)
//  - serverUpdatedAt : horloge serveur, sert de curseur pour le « pull » incrémental
//  - deletedAt : suppression logique (tombstone) pour propager les suppressions

model Envelope {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String
  budgeted        Decimal   @default(0) @db.Decimal(12, 2)
  color           String    @default("bg-primary-fixed")
  icon            String    @default("category")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  depenses Depense[]

  @@index([userId, serverUpdatedAt])
  @@map("envelopes")
}

model Revenu {
  id               String         @id @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  label            String
  amount           Decimal        @db.Decimal(12, 2)
  category         RevenuCategory
  type             String         @default("autre")
  date             DateTime       @db.Date
  recurring        Boolean        @default(false)
  recurringGroupId String?        @map("recurring_group_id") @db.Uuid
  createdAt        DateTime       @map("created_at")
  updatedAt        DateTime       @map("updated_at")
  serverUpdatedAt  DateTime       @default(now()) @map("server_updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, serverUpdatedAt])
  @@map("revenus")
}

model Depense {
  id               String          @id @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  label            String
  amount           Decimal         @db.Decimal(12, 2)
  category         DepenseCategory
  envelopeId       String?         @map("envelope_id") @db.Uuid
  date             DateTime        @db.Date
  recurring        Boolean         @default(false)
  recurringGroupId String?         @map("recurring_group_id") @db.Uuid
  createdAt        DateTime        @map("created_at")
  updatedAt        DateTime        @map("updated_at")
  serverUpdatedAt  DateTime        @default(now()) @map("server_updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelope Envelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, serverUpdatedAt])
  @@index([envelopeId])
  @@map("depenses")
}

model Objectif {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  label           String
  targetAmount    Decimal   @default(0) @map("target_amount") @db.Decimal(12, 2)
  currentAmount   Decimal   @default(0) @map("current_amount") @db.Decimal(12, 2)
  deadline        DateTime? @db.Date
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverUpdatedAt])
  @@map("objectifs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String
  body      String
  type      NotificationType @default(info)
  read      Boolean          @default(false)
  createdBy String?          @map("created_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @default("unknown")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String?       @map("user_id") @db.Uuid
  userEmail  String?       @map("user_email")
  message    String
  status     SupportStatus @default(new)
  adminReply String?       @map("admin_reply")
  createdAt  DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("support_messages")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  targetId  String?  @map("target_id") @db.Uuid
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
}
