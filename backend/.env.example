# --- Base de données (docker compose up -d db) ---
DATABASE_URL="postgresql://monbudget:monbudget@localhost:5433/monbudget?schema=public"

# --- Serveur ---
PORT=3000
# Origines autorisées (CORS), séparées par des virgules. Vide = aucune origine navigateur.
CORS_ORIGINS=

# --- JWT ---
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60

# --- Google Sign-In (IDs clients OAuth Web/Android/iOS, séparés par des virgules) ---
GOOGLE_CLIENT_IDS=

# --- Emails (réinitialisation de mot de passe). Sans SMTP_HOST, le code est écrit dans les logs. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mon Budget <no-reply@example.com>"

# --- Suivi des erreurs (Sentry, optionnel) : https://sentry.io > projet Node.js > DSN ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
